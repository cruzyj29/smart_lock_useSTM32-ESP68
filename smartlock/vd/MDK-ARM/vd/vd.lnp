"vd\stm32f1xx_hal_rcc.o"
"vd\stm32f1xx_hal_rcc_ex.o"
"vd\stm32f1xx_hal_gpio.o"
"vd\stm32f1xx_hal_dma.o"
"vd\stm32f1xx_hal_cortex.o"
